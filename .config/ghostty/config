# Follow the system appearance with matching CRT palettes.
theme = light:Retro Paper,dark:Retro Green

cursor-style = underline
cursor-style-blink = true
shell-integration-features = no-cursor
# Use IBM VGA 8x16 for terminal text.
font-family = PxPlus IBM VGA 8x16
font-size = 16
# Use Maple Mono only for Nerd Font symbols, not ordinary text.
font-codepoint-map = U+E000-U+F8FF,U+F0000-U+FFFFD=Maple Mono NF

background-opacity = 1
background-blur = false

# Generated from shaders/crt.glsl by ./reload-shader.
# Eight real passes preserve the original appearance and GPU cost.
custom-shader = /Users/rkrsn/Library/Caches/ghostty-crt/55d8df346486db20/pass-0.glsl
custom-shader = /Users/rkrsn/Library/Caches/ghostty-crt/55d8df346486db20/pass-1.glsl
custom-shader = /Users/rkrsn/Library/Caches/ghostty-crt/55d8df346486db20/pass-2.glsl
custom-shader = /Users/rkrsn/Library/Caches/ghostty-crt/55d8df346486db20/pass-3.glsl
custom-shader = /Users/rkrsn/Library/Caches/ghostty-crt/55d8df346486db20/pass-4.glsl
custom-shader = /Users/rkrsn/Library/Caches/ghostty-crt/55d8df346486db20/pass-5.glsl
custom-shader = /Users/rkrsn/Library/Caches/ghostty-crt/55d8df346486db20/pass-6.glsl
custom-shader = /Users/rkrsn/Library/Caches/ghostty-crt/55d8df346486db20/pass-7.glsl
custom-shader-animation = true

# Merge tabs into the title bar when window decorations are enabled.
macos-titlebar-style = tabs

# Remove the native window frame and shadow.
window-decoration = none
macos-window-shadow = false
# Distribute leftover terminal-cell space evenly around the window.
window-padding-balance = true

# macOS service "Open Stagger Juice SSH Tab" handles Cmd+Shift+T.
# Leave the key free for the service instead of typing into the terminal.
keybind = super+shift+t=unbind

# Toggle the drop-down terminal from any application.
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top

# Turn off drop-down window animation

quick-terminal-size = 100%,100%

fullscreen = non-native-padded-notch

macos-non-native-fullscreen = padded-notch
