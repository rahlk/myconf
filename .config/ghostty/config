# Follow the system appearance with matching CRT palettes.
theme = light:CRT Blue,dark:Retro Green

cursor-style = underline
cursor-style-blink = true
shell-integration-features = no-cursor
# Use PxPlus IBM VGA 8x16 for terminal text.
font-family = ""
# font-family = PxPlus IBM EGA 9x14
# font-family = Departure Mono
font-family = PxPlus IBM VGA 8x16
# font-family = Maple Mono NF
font-size = 18
# Use Maple Mono only for Nerd Font symbols, not ordinary text.
font-codepoint-map = U+E000-U+F8FF,U+F0000-U+FFFFD=Maple Mono NF

background-opacity = 1
background-blur = false

custom-shader = shaders/block-cursor-halo.glsl
# Continuous light jitter; occasional random bursts and bands with RGB splitting.
custom-shader = shaders/glitch-timed-color.glsl
# Flat CRT screen and scan lines, without text bloom.
custom-shader = shaders/crt-no-bloom.glsl
# Bright monochrome text for the green and Ubuntu profiles.
custom-shader = shaders/phosphor-vivid.glsl
custom-shader = shaders/crt-finish-shared.glsl
custom-shader-animation = true

# Merge tabs into the title bar when window decorations are enabled.
macos-titlebar-style = tabs

# Remove the native window frame and shadow.
window-decoration = none
macos-window-shadow = false

# macOS service "Open Stagger Juice SSH Tab" handles Cmd+Shift+T.
# Leave the key free for the service instead of typing into the terminal.
keybind = super+shift+t=unbind

# Toggle the drop-down terminal from any application.
keybind = global:ctrl+backquote=toggle_quick_terminal
quick-terminal-position = top

# Turn off drop-down window animation

quick-terminal-size = 100%,100%

fullscreen = non-native

macos-non-native-fullscreen = true
