# Follow the system appearance with matching CRT palettes.
theme = light:CRT GitHub Light,dark:Retro Green

cursor-style = underline
cursor-style-blink = true
shell-integration-features = no-cursor
# Use IBM VGA 8x16 for terminal text.
font-family = PxPlus IBM VGA 8x16
font-size = 16
# Use Maple Mono only for Nerd Font symbols, not ordinary text.
font-codepoint-map = U+E000-U+F8FF,U+F0000-U+FFFFD=Maple Mono NF

background-opacity = 1
background-blur = false

custom-shader = shaders/block-cursor-halo.glsl
# Analog jitter with subtle brightness flutter; occasional bursts and RGB bands.
custom-shader = shaders/glitch-timed-color-v2.glsl
# CRT scan lines and phosphor mask.
custom-shader = shaders/crt-texture-v2.glsl
# Bright monochrome text for the green and Ubuntu profiles.
custom-shader = shaders/phosphor-vivid-v2.glsl
custom-shader = shaders/crt-finish-v2.glsl
# A 3px phosphor glow softens bright text and scanline gaps.
custom-shader = shaders/phosphor-bloom-v3.glsl
# Flat final overlay keeps mouse coordinates aligned with text and tabs.
custom-shader = shaders/crt-overlay-v5.glsl
custom-shader-animation = true

# Merge tabs into the title bar when window decorations are enabled.
macos-titlebar-style = tabs

# Remove the native window frame and shadow.
window-decoration = none
macos-window-shadow = false
# Distribute leftover terminal-cell space evenly around the window.
window-padding-balance = true

# macOS service "Open Stagger Juice SSH Tab" handles Cmd+Shift+T.
# Leave the key free for the service instead of typing into the terminal.
keybind = super+shift+t=unbind

# Toggle the drop-down terminal from any application.
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top

# Turn off drop-down window animation

quick-terminal-size = 100%,100%

fullscreen = non-native-padded-notch

macos-non-native-fullscreen = padded-notch
