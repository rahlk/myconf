# Black ink on pale yellow paper, matching the Retro Green CRT setup.
background = #faf7ed
foreground = #171717
# Darker ink provides bold emphasis without thickening the bitmap glyphs.
bold-color = #000000
font-style-bold = false
font-style-bold-italic = false
cursor-color = #171717
cursor-text = #faf7ed
selection-background = #d4d2ca
selection-foreground = #000000

