// Bright DOS white text on blue, with yellow selections and gray menus.
themes {
    crt-light {
        text_unselected {
            base 255 255 255
            background 0 0 170
            emphasis_0 255 255 255
            emphasis_1 255 255 85
            emphasis_2 85 255 255
            emphasis_3 255 255 255
        }
        text_selected {
            base 0 0 0
            background 255 255 85
            emphasis_0 0 0 0
            emphasis_1 170 0 0
            emphasis_2 0 0 170
            emphasis_3 0 0 0
        }
        ribbon_selected {
            base 0 0 0
            background 170 170 170
            emphasis_0 0 0 170
            emphasis_1 170 0 0
            emphasis_2 0 0 0
            emphasis_3 0 0 170
        }
        ribbon_unselected {
            base 255 255 255
            background 0 0 170
            emphasis_0 255 255 255
            emphasis_1 255 255 85
            emphasis_2 85 255 255
            emphasis_3 255 255 255
        }
        table_title {
            base 255 255 255
            background 0 0 170
            emphasis_0 255 255 255
            emphasis_1 255 255 85
            emphasis_2 85 255 255
            emphasis_3 255 255 255
        }
        table_cell_selected {
            base 0 0 0
            background 255 255 85
            emphasis_0 0 0 0
            emphasis_1 170 0 0
            emphasis_2 0 0 170
            emphasis_3 0 0 0
        }
        table_cell_unselected {
            base 255 255 255
            background 0 0 170
            emphasis_0 255 255 255
            emphasis_1 255 255 85
            emphasis_2 85 255 255
            emphasis_3 255 255 255
        }
        list_selected {
            base 0 0 0
            background 255 255 85
            emphasis_0 0 0 0
            emphasis_1 170 0 0
            emphasis_2 0 0 170
            emphasis_3 0 0 0
        }
        list_unselected {
            base 255 255 255
            background 0 0 170
            emphasis_0 255 255 255
            emphasis_1 255 255 85
            emphasis_2 85 255 255
            emphasis_3 255 255 255
        }
        frame_unselected {
            base 255 255 255
            background 0 0 170
            emphasis_0 255 255 255
            emphasis_1 255 255 255
            emphasis_2 255 255 255
            emphasis_3 255 255 255
        }
        frame_selected {
            base 255 255 255
            background 0 0 170
            emphasis_0 255 255 255
            emphasis_1 255 255 255
            emphasis_2 255 255 255
            emphasis_3 255 255 255
        }
        frame_highlight {
            base 255 255 85
            background 0 0 170
            emphasis_0 255 255 85
            emphasis_1 255 255 255
            emphasis_2 255 255 85
            emphasis_3 255 255 255
        }
        exit_code_success {
            base 0 0 0
            background 170 170 170
            emphasis_0 0 170 0
            emphasis_1 0 0 0
            emphasis_2 0 0 170
            emphasis_3 0 0 0
        }
        exit_code_error {
            base 170 0 0
            background 170 170 170
            emphasis_0 170 0 0
            emphasis_1 0 0 0
            emphasis_2 170 0 0
            emphasis_3 0 0 0
        }
        multiplayer_user_colors {
            player_1 85 255 255
            player_2 255 255 85
            player_3 255 255 255
            player_4 85 255 85
            player_5 255 85 85
            player_6 255 85 255
            player_7 170 170 170
            player_8 0 170 170
            player_9 0 170 0
            player_10 170 0 0
        }
    }
}
