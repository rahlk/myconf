// Powerline session and tab segments, with time and date on the right.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="file:/Users/rkrsn/.config/zellij/plugins/zjstatus.wasm" {
                format_left "#[fg=#39ff6a,bg=#000000,bold] {session} {tabs}"
                format_left_blue "#[fg=#ffffff,bg=#008080,bold] {session} {tabs}"
                format_center ""
                format_right "#[fg=#585858,bg=#303030]{command_time}{command_date}"
                format_right_blue "#[fg=#585858,bg=#008080]{command_time}{command_date}"
                format_space "#[bg=#303030]"
                format_space_blue "#[bg=#008080]"
                border_enabled "false"
                hide_frame_for_single_pane "false"
                tab_normal "#[fg=#ffffff,bg=#585858,bold] {name} "
                tab_active "#[fg=#000000,bg=#39ff6a,bold] {name} "
                tab_separator ""
                tab_powerline "true"
                command_time_command "/usr/bin/env LC_TIME=C /bin/date '+%H:%M %Z'"
                command_time_format "#[fg=#ff8700,bg=#585858,bold] {stdout} "
                command_time_interval "5"
                command_time_rendermode "static"
                command_date_command "/usr/bin/env LC_TIME=C /bin/date '+%m/%d/%Y'"
                command_date_format "#[fg=#d0d0d0,bg=#585858]#[fg=#303030,bg=#d0d0d0,bold] {stdout} "
                command_date_interval "30"
                command_date_rendermode "static"
            }
        }
        children
    }
    tab
}
