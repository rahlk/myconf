// Windows teal top tabs with white labels and the system date and time.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="file:/Users/rkrsn/.config/zellij/plugins/zjstatus.wasm" {
                format_left "#[bg=#008080]| {tabs}"
                format_center ""
                format_right "{command_clock}"
                format_space "#[bg=#008080]"

                border_enabled "false"
                hide_frame_for_single_pane "false"

                tab_normal "#[bg=#008080] {name} "
                tab_active "#[bg=#008080] [{name}] "
                tab_separator ""

                command_clock_command "/usr/bin/env LC_TIME=C /bin/date '+%m/%d/%Y %H:%M %Z'"
                command_clock_format "#[bg=#008080] {stdout} "
                command_clock_interval "5"
                command_clock_rendermode "static"
            }
        }
        children
    }
    tab
}
