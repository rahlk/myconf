+    fn powerline_config() -> BTreeMap<String, String> {
+        BTreeMap::from([
+            ("tab_powerline".to_owned(), "true".to_owned()),
+            (
+                "tab_normal".to_owned(),
+                "#[fg=white,bg=#585858] {name} ".to_owned(),
+            ),
+            (
+                "tab_active".to_owned(),
+                "#[fg=black,bg=#39ff6a] {name} ".to_owned(),
+            ),
+            ("tab_separator".to_owned(), " | ".to_owned()),
+            ("format_space".to_owned(), "#[bg=#303030]".to_owned()),
+        ])
+    }
+
+    fn tab_state(names: &[&str], active: usize) -> ZellijState {
+        ZellijState {
+            tabs: names
+                .iter()
+                .enumerate()
+                .map(|(position, name)| TabInfo {
+                    position,
+                    name: (*name).to_owned(),
+                    active: position == active,
+                    ..TabInfo::default()
+                })
+                .collect(),
+            ..ZellijState::default()
+        }
+    }
+
+    #[test]
+    fn powerline_connects_normal_background_to_active_background() {
+        let widget = TabsWidget::new(&powerline_config());
+        let output = widget.process("tabs", &tab_state(&["one", "two"], 1));
+
+        assert!(
+            output.contains("\u{1b}[38;2;88;88;88m\u{1b}[48;2;57;255;106m"),
+            "{output:?}"
+        );
+    }
+
+    #[test]
