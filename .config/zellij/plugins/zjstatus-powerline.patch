+        let state = tab_state(&["界", "two", "three"], 2);
+        let output = widget.process("tabs", &state);
+
+        assert!(
+            output.contains("\u{1b}[37m\u{1b}[48;2;88;88;88m"),
+            "{output:?}"
+        );
+        assert_eq!(console::strip_ansi_codes(&output), " 界  two  three ");
+        assert_eq!(console::measure_text_width(&output), 19);
+        assert_eq!(
+            widget.tab_click_target(&state.tabs, &state, 11, 7).0,
+            Some(1)
+        );
+        assert_eq!(
+            widget.tab_click_target(&state.tabs, &state, 12, 7).0,
+            Some(2)
+        );
+    }
