+        let widget = TabsWidget::new(&powerline_config());
+        let output = widget.process("tabs", &tab_state(&["one", "two"], 0));
+
+        assert!(
+            output.contains("\u{1b}[38;2;57;255;106m\u{1b}[48;2;88;88;88m"),
+            "{output:?}"
+        );
+    }
+
+    #[test]
+    fn powerline_equal_backgrounds_use_visible_thin_chevron_with_one_column_click_width() {
