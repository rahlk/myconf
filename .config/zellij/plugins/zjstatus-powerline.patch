 impl TabsWidget {
+    fn render_tab_segment(
+        &self,
+        tab: &TabInfo,
+        next_tab: Option<&TabInfo>,
+        state: &ZellijState,
+    ) -> String {
+        let mut output = self.render_tab(tab, &state.panes, &state.mode);
+        if self.tab_powerline {
+            let current_edge = self
+                .select_format(tab, &state.mode)
+                .iter()
+                .rev()
+                .find(|part| !part.content.is_empty());
+            let current_background = current_edge.and_then(|part| part.bg);
+            let next_background = next_tab.map_or(self.powerline_background, |next| {
+                self.select_format(next, &state.mode)
+                    .iter()
+                    .find(|part| !part.content.is_empty())
+                    .and_then(|part| part.bg)
+            });
+            let shared_background = next_tab.is_some()
+                && current_background.is_some()
+                && current_background == next_background;
+            let arrow = FormattedPart {
+                fg: if shared_background {
+                    current_edge.and_then(|part| part.fg)
+                } else {
+                    current_background
+                },
+                bg: next_background,
+                ..FormattedPart::default()
+            };
+            output.push_str(&arrow.format_string(if shared_background { "" } else { "" }));
+        } else if next_tab.is_some()
+            && let Some(separator) = &self.separator
+        {
+            output.push_str(&separator.format_string(&separator.content));
+        }
+        output
+    }
+
+    fn tab_click_target(
+        &self,
+        tabs: &[TabInfo],
+        state: &ZellijState,
+        pos: usize,
+        mut offset: usize,
+    ) -> (Option<usize>, usize) {
+        for (index, tab) in tabs.iter().enumerate() {
+            let content = self.render_tab_segment(tab, tabs.get(index + 1), state);
+            let content_len = console::measure_text_width(&content);
+            let after_start = if self.tab_powerline {
+                pos >= offset
+            } else {
+                pos > offset
+            };
+            if after_start && pos < offset + content_len {
+                return (Some(tab.position + 1), offset + content_len);
+            }
+            offset += content_len;
+        }
+        (None, offset)
+    }
+
